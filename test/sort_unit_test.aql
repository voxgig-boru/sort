# sort — direct unit tests using boru:test's imperative API.
#
# Example-based checks: each algorithm sorts known inputs to known
# outputs, the comparators impose the expected orders, and the error
# paths raise the documented codes. The sibling `test/sort_unit_spec.aql`
# covers the same ground through the declarative spec surface.
#
# Run:
#   boru test/sort_unit_test.aql

import "boru:test"
import "../sort.aql"


# --- every comparison sort on a shared example ----------------------
#
# Same input, same expected output — exercises each algorithm's happy
# path against a non-trivial list with a duplicate.

def sample [5 3 8 3 1 9 2 7]
def sorted [1 2 3 3 5 7 8 9]

Test.test "bubble"    [ Assert.equal sorted (sample Sort.bubble    Sort.by-number/v end) ]
Test.test "insertion" [ Assert.equal sorted (sample Sort.insertion Sort.by-number/v end) ]
Test.test "selection" [ Assert.equal sorted (sample Sort.selection Sort.by-number/v end) ]
Test.test "gnome"     [ Assert.equal sorted (sample Sort.gnome     Sort.by-number/v end) ]
Test.test "cocktail"  [ Assert.equal sorted (sample Sort.cocktail  Sort.by-number/v end) ]
Test.test "comb"      [ Assert.equal sorted (sample Sort.comb      Sort.by-number/v end) ]
Test.test "shell"     [ Assert.equal sorted (sample Sort.shell     Sort.by-number/v end) ]
Test.test "odd-even"  [ Assert.equal sorted (sample Sort.odd-even  Sort.by-number/v end) ]
Test.test "cycle"     [ Assert.equal sorted (sample Sort.cycle     Sort.by-number/v end) ]
Test.test "pancake"   [ Assert.equal sorted (sample Sort.pancake   Sort.by-number/v end) ]
Test.test "bitonic"   [ Assert.equal sorted (sample Sort.bitonic   Sort.by-number/v end) ]
Test.test "quick"     [ Assert.equal sorted (sample Sort.quick     Sort.by-number/v end) ]
Test.test "merge"     [ Assert.equal sorted (sample Sort.merge     Sort.by-number/v end) ]
Test.test "heap"      [ Assert.equal sorted (sample Sort.heap      Sort.by-number/v end) ]
Test.test "intro"     [ Assert.equal sorted (sample Sort.intro     Sort.by-number/v end) ]
Test.test "tim"       [ Assert.equal sorted (sample Sort.tim       Sort.by-number/v end) ]
Test.test "stooge"    [ Assert.equal sorted (sample Sort.stooge    Sort.by-number/v end) ]
Test.test "slow"      [ Assert.equal sorted (sample Sort.slow      Sort.by-number/v end) ]
Test.test "sort"      [ Assert.equal sorted (sample Sort.sort      Sort.by-number/v end) ]


# --- distribution sorts (no comparator) -----------------------------

Test.test "counting"   [ Assert.equal sorted (sample Sort.counting   end) ]
Test.test "pigeonhole" [ Assert.equal sorted (sample Sort.pigeonhole end) ]
Test.test "radix-lsd"  [ Assert.equal sorted (sample Sort.radix-lsd  end) ]
Test.test "radix-msd"  [ Assert.equal sorted (sample Sort.radix-msd  end) ]
Test.test "bucket"     [ Assert.equal sorted (sample Sort.bucket     end) ]
Test.test "bead"       [ Assert.equal sorted (sample Sort.bead       end) ]

# multi-digit values stress the radix / bucket paths
Test.test "radix-lsd-multidigit" [
  Assert.equal [1 5 10 11 55 100 1000] ([1000 10 100 1 11 5 55] Sort.radix-lsd end)
]
Test.test "radix-msd-multidigit" [
  Assert.equal [1 5 10 11 55 100 1000] ([1000 10 100 1 11 5 55] Sort.radix-msd end)
]


# --- bogosort on a tiny input ---------------------------------------

Test.test "bogo-tiny" [ Assert.equal [1 2 3] ([3 1 2] Sort.bogo Sort.by-number/v end) ]


# --- edge cases -----------------------------------------------------

Test.test "empty"        [ Assert.equal [] ([] Sort.quick Sort.by-number/v end) ]
Test.test "singleton" [ Assert.equal [42] ([42] Sort.merge Sort.by-number/v end) ]
Test.test "all-equal" [ Assert.equal [7 7 7] ([7 7 7] Sort.heap Sort.by-number/v end) ]
Test.test "already-sorted" [ Assert.equal [1 2 3 4] ([1 2 3 4] Sort.quick Sort.by-number/v end) ]
Test.test "reversed" [ Assert.equal [1 2 3 4] ([4 3 2 1] Sort.quick Sort.by-number/v end) ]
Test.test "empty-counting" [ Assert.equal [] ([] Sort.counting end) ]


# --- comparators ----------------------------------------------------

Test.test "by-string" [ Assert.equal ["Apple" "banana" "fig" "pear"] (["pear" "Apple" "fig" "banana"] Sort.merge Sort.by-string/v end) ]
Test.test "by-boolean" [ Assert.equal [false false true true] ([true false true false] Sort.merge Sort.by-boolean/v end) ]
Test.test "floats" [ Assert.equal [0.1 1.2 2.8 3.5] ([3.5 1.2 2.8 0.1] Sort.quick Sort.by-number/v end) ]

# natural / alphanumeric ordering — the headline utility
Test.test "natural" [ Assert.equal ["file1" "file2" "file10" "file20"] (["file10" "file2" "file20" "file1"] Sort.merge Sort.natural/v end) ]
Test.test "natural-x" [ Assert.equal ["x2" "x10"] (["x10" "x2"] Sort.merge Sort.natural/v end) ]

# case-insensitive
Test.test "case-insensitive" [ Assert.equal ["apple" "Banana" "Cherry"] (["Cherry" "apple" "Banana"] Sort.merge Sort.case-insensitive/v end) ]

# combinators: reverse and by-key
Test.test "reverse" [ Assert.equal [9 5 3 1] ([3 9 1 5] Sort.quick (Sort.by-number/v Sort.reverse) end) ]


# --- predicate ------------------------------------------------------

Test.test "is-sorted-true"  [ Assert.equal true ([1 2 3]   Sort.is-sorted Sort.by-number/v end) ]
Test.test "is-sorted-false" [ Assert.equal false ([3 1 2]   Sort.is-sorted Sort.by-number/v end) ]
Test.test "is-sorted-empty" [ Assert.equal true ([]        Sort.is-sorted Sort.by-number/v end) ]


# --- error paths ----------------------------------------------------

# A distribution sort rejects non-Integer elements.
Test.test "counting-needs-ints" [ Assert.throws [["a" "b"] Sort.counting end] ]
def e1 (do [["a" "b"] Sort.counting end])
Test.test "counting-bad_input-code" [ Assert.equal bad_input/q (e1.code) ]

# Radix rejects negatives.
Test.test "radix-needs-non-neg" [ Assert.throws [[3 -1 2] Sort.radix-lsd end] ]
def e2 (do [[3 -1 2] Sort.radix-lsd end])
Test.test "radix-bad_input-code" [ Assert.equal bad_input/q (e2.code) ]


# --- summary --------------------------------------------------------

# One value per `print`, in forward form, and the final assertion with its
# operands written forward: the old chained spelling (`"---" print "fail
# count: " print Test.fail-count end print`, then `0 Test.fail-count end
# Assert.equal end`) evaluates out of source order on boru main, dropped
# the "---" line, and compared the fail count against a stray stack value.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
