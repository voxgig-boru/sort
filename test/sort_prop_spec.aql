# Property-based tests for sort — DECLARATIVE SPEC FORMAT.
#
# The spec-format sibling of the direct-code `test/sort_prop_test.aql`.
# Each entry is a `PropertySpec` built by `Test.prop` and run by
# `Test.run-property`; the generator and property bodies are ordinary
# code, so (unlike the example spec) these CAN drive the comparison sorts
# that take a comparator argument.
#
#   Test.prop NAME  [ GEN-BODY ]  [ PROP-BODY ]
#
# GEN-BODY runs with `r` bound to the random source and leaves one value
# (the input list). PROP-BODY takes that list and returns a Boolean.
#
# Run:
#   boru test/sort_prop_spec.aql

import "boru:test"
import "../sort.aql"


# Works around a boru compile defect (boru main @ 64c5ab2): a `Test.prop`
# body that reads a NAMESPACE member by `/v` (`Sort.by-number/v`) is
# refused — "code-body word test-prop (Stage 2)" — while a module-level
# binding read by `/v` compiles. So the property bodies pass `by-num/v`.
# Go back to `Sort.by-number/v` inline when the defect is fixed upstream.
def by-num (Sort.by-number/v)


# --- reporting helper (one PropertyResult → a pass/fail line) --------

def report fn [
  [res:Map] [] [
    def ok (res "ok" get)
    def nm (res "name" get)
    def msg (if ok
      [`ok   ${nm} (${(res "runs" get)} runs)`]
      [`FAIL ${nm}  failing-input: ${(res "failing-input" get)}`])
    msg print
  ]
]


# --- the spec suite, built as data ----------------------------------

def specs [

  # Keystone: every comparison sort agrees with the stable merge sort.
  (Test.prop "all-comparison-sorts-agree-with-merge"
    [ iota (r.int 0 7) each [ var [[i] r.int 0 12 ] ] ]
    [ var [[lst]
        def want (lst Sort.merge by-num/v end)
        def results [
          (lst Sort.bubble    by-num/v end)
          (lst Sort.insertion by-num/v end)
          (lst Sort.selection by-num/v end)
          (lst Sort.gnome     by-num/v end)
          (lst Sort.cocktail  by-num/v end)
          (lst Sort.comb      by-num/v end)
          (lst Sort.shell     by-num/v end)
          (lst Sort.odd-even  by-num/v end)
          (lst Sort.cycle     by-num/v end)
          (lst Sort.pancake   by-num/v end)
          (lst Sort.bitonic   by-num/v end)
          (lst Sort.quick     by-num/v end)
          (lst Sort.heap      by-num/v end)
          (lst Sort.intro     by-num/v end)
          (lst Sort.tim       by-num/v end)
        ]
        def ok (flex [true])
        def _ (results each [ var [[r] if ((r deq want) not) [ ok set 0 false end drop 0 ] [0] ] ])
        ok get 0
    ] ])

  # Distribution sorts agree with merge on non-negative integers.
  (Test.prop "distribution-sorts-agree-with-merge"
    [ iota (r.int 0 8) each [ var [[i] r.int 0 40 ] ] ]
    [ var [[lst]
        def want (lst Sort.merge by-num/v end)
        def results [
          (lst Sort.counting   end)
          (lst Sort.pigeonhole end)
          (lst Sort.radix-lsd  end)
          (lst Sort.radix-msd  end)
          (lst Sort.bucket     end)
          (lst Sort.bead       end)
        ]
        def ok (flex [true])
        def _ (results each [ var [[r] if ((r deq want) not) [ ok set 0 false end drop 0 ] [0] ] ])
        ok get 0
    ] ])

  # The output of a sort is ordered.
  (Test.prop "output-is-ordered"
    [ iota (r.int 0 14) each [ var [[i] r.int 0 50 ] ] ]
    [ var [[lst] (lst Sort.quick by-num/v end) Sort.is-sorted by-num/v end ] ])

  # Sorting is idempotent.
  (Test.prop "sort-is-idempotent"
    [ iota (r.int 0 14) each [ var [[i] r.int 0 50 ] ] ]
    [ var [[lst]
        def once  (lst  Sort.merge by-num/v end)
        def twice (once Sort.merge by-num/v end)
        (once deq twice)
    ] ])

  # Reversed comparator yields the reversed ordering.
  (Test.prop "reverse-comparator-reverses-output"
    [ iota (r.int 0 12) each [ var [[i] r.int 0 100 ] ] ]
    [ var [[lst]
        def asc  (lst Sort.heap by-num/v end)
        def desc (lst Sort.heap (by-num/v Sort.reverse) end)
        (desc deq (asc reverse))
    ] ])

]


# --- run every spec ------------------------------------------------

def _ (specs each [
  var [[s]
    (s Test.run-property end) report
    0
  ]
])


# --- summary -------------------------------------------------------

# One value per `print`, in forward form, and the final assertion with its
# operands written forward: the old chained spelling (`"---" print "fail
# count: " print Test.fail-count end print`, then `0 Test.fail-count end
# Assert.equal end`) evaluates out of source order on boru main, dropped
# the "---" line, and compared the fail count against a stray stack value.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
