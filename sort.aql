# sort.aql — every sorting algorithm, over every boru type, in boru.
#
# Public surface: the single `Sort` namespace, exported at the bottom.
# Two kinds of word live in it:
#
#   * COMPARATORS — two-argument function values returning an Integer that
#     is negative / zero / positive when the first item sorts before /
#     equal to / after the second. Defaults per type plus alphanumeric and
#     case-folding orders, and combinators that build new comparators:
#     `Sort.by-number`, `Sort.by-string`, `Sort.by-boolean`,
#     `Sort.by-generic`, `Sort.natural`, `Sort.case-insensitive`,
#     `Sort.reverse`, `Sort.by-key`.
#
#   * ALGORITHMS — each takes a List and returns a NEW sorted List; the
#     input is never mutated (the opposite of an in-place library). The
#     comparison sorts take a comparator argument; the distribution sorts
#     (counting/radix/…) take none and order Integers ascending.
#
# Calling convention (boru is not C/Python/JS): forward, verb first, with
# the receiver — the list — LAST. Piping the list in from the left binds
# the same (wrap it in parens or end it with `end`):
#
#     Sort.quick Sort.by-number/v [3 1 2]        → [1 2 3]
#     [3 1 2] Sort.quick Sort.by-number/v end    → [1 2 3]   (piping)
#     Sort.merge Sort.natural/v names
#     Sort.heap  mycmp/v xs                      # your own comparator word
#     Sort.quick cmp/v xs                        # the built-in `cmp`
#     Sort.counting ints                         # no comparator
#
# EVERY comparator passed as an argument carries `/v` — a namespace member
# (`Sort.by-number/v`), your own word (`mycmp/v`) and the built-in
# (`cmp/v`) alike. A bare name that holds a function CALLS it wherever it
# appears (ADR-011); `/v` hands the function over as a value. The
# combinators take and return comparators the same way:
# `(Sort.reverse Sort.by-number/v)`, `(Sort.by-key keyfn/v)`.
#
# Why one file: comparators and algorithms were kept in one module when a
# function value's free words resolved in the module that RAN it. boru
# fixed that (a fn value now resolves in its defining module), but one
# corner still breaks — see `fold-case` below — so the single file stays.
#
# Errors (catch with `do […] error […]`, read `e.code`):
#   bad_input    a distribution sort got a non-Integer / out-of-span item
#   bogo_giveup  Sort.bogo exceeded its safety cap without sorting

import "boru:string-util"
import "boru:math-util"


# ====================================================================
# COMPARATORS
# ====================================================================
#
# A comparator's signature is `[b:T a:T] [Integer]`. boru's rule is "the
# first signature parameter is the top of the stack", so when a sort
# invokes `xi xj comp`, the first-written item `xi` binds to `a` and the
# second `xj` to `b`. Writing the body in terms of `a` (earlier) and `b`
# (later) then reads naturally: "a before b ⇒ negative".

# --- default comparators (one per boru type) ------------------------
#
# Each defers to the native `cmp` — a polymorphic three-way compare that
# never subtracts, so there is no 63-bit integer-overflow risk.

def by-number fn [
  [b:Any a:Any] [Integer] [ (a cmp b) ]
]

def by-string fn [
  [b:String a:String] [Integer] [ (a cmp b) ]
]

def by-boolean fn [
  [b:Boolean a:Boolean] [Integer] [ (a cmp b) ]
]

def by-generic fn [
  [b:Any a:Any] [Integer] [ (a cmp b) ]
]


# --- natural / alphanumeric ordering --------------------------------
#
# Orders strings so embedded runs of digits compare by numeric value, not
# character by character: "file2" < "file10", "x9" < "x10". Each string is
# read as an alternating sequence of digit and non-digit chunks; digit
# chunks compare as Integers, the rest lexicographically.

def is-digit fn [
  [ch:String] [Boolean] [
    (ch gte "0") and (ch lte "9")
  ]
]

# From index `i` in string `s`, the end index (exclusive) of the maximal
# run starting at `i` whose digit-ness equals `want`.
def run-end fn [
  [want:Boolean i:Integer s:String] [Integer] [
    def n (s size)
    def cur (flex [i])
    def _ (iota n each [
      var [[t]
        def j (cur get 0)
        if (j lt n) [
          def ch (s slice j (j add 1))
          if ((ch is-digit) eq want) [ cur set 0 (j add 1) end drop 0 ] [0]
        ] [0]
      ]
    ])
    cur get 0
  ]
]

# Compare two strings naturally. Walks both with cursors held in
# single-cell FlexLists — a bounded `iota` loop rather than recursion. (It
# was written that way when a recursive helper reached through a function
# parameter did not resolve; boru main resolves it now, but the loop is
# kept: it is correct, compiles, and needs no stack depth.) At most
# `len(a) + len(b) + 1` steps are needed; once a verdict is reached the
# `done` flag idles the remaining iterations.
def natural fn [
  [b:String a:String] [Integer] [
    def na (a size)
    def nb (b size)
    def ia   (flex [0])
    def ib   (flex [0])
    def res  (flex [0])
    def done (flex [false])
    def _ (iota ((na add nb) add 1) each [
      var [[t]
        if (done get 0) [0] [
          def pa (ia get 0)
          def pb (ib get 0)
          if ((pa gte na) and (pb gte nb)) [ done set 0 true end drop 0 ] [
            if (pa gte na) [ res set 0 -1 end drop  done set 0 true end drop  0 ] [
              if (pb gte nb) [ res set 0 1 end drop  done set 0 true end drop  0 ] [
                def cha (a slice pa (pa add 1))
                def chb (b slice pb (pb add 1))
                if ((cha is-digit) and (chb is-digit)) [
                  def ea (a pa true run-end)
                  def eb (b pb true run-end)
                  def va (convert Integer (a slice pa ea))
                  def vb (convert Integer (b slice pb eb))
                  def c (va vb by-number)
                  if (c neq 0) [ res set 0 c end drop  done set 0 true end drop  0 ] [
                    ia set 0 ea end drop  ib set 0 eb end drop  0
                  ]
                ] [
                  def c (cha chb by-string)
                  if (c neq 0) [ res set 0 c end drop  done set 0 true end drop  0 ] [
                    ia set 0 (pa add 1) end drop  ib set 0 (pb add 1) end drop  0
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ])
    res get 0
  ]
]


# --- case-insensitive string ordering -------------------------------

# Works around a boru defect (boru main @ 64c5ab2, unrecorded upstream): a
# comparator that reads an IMPORTED namespace (`StringUtil.lower`) directly
# raises `undefined word: StringUtil` when a sort applies it as a fn value
# for a caller that did not import boru:string-util itself. A by-name
# private helper resolves in this module, so the namespace read lives
# here. Inline it back into `case-insensitive` when fixed upstream.
def fold-case fn [
  [s:String] [String] [ s StringUtil.lower ]
]

def case-insensitive fn [
  [b:String a:String] [Integer] [
    def la (a fold-case)
    def lb (b fold-case)
    (la lb by-string)
  ]
]


# --- combinators ----------------------------------------------------
#
# Each returns a NEW comparator (a closure over its arguments), so they
# compose, e.g. `(keyfn Sort.by-key Sort.by-number) Sort.reverse`.

def rev-cmp fn [
  [comp:Function] [Function] [
    [b:Any a:Any] => [ 0 sub (a b comp) ]
  ]
]

# Order by a derived key. `keyfn` maps each item to a key; the keys are
# ordered by the native `cmp` (numbers numerically, strings
# lexicographically). One captured function, so it composes through a
# sort (e.g. `(len-of Sort.by-key) Sort.reverse`).
def by-key-cmp fn [
  [keyfn:Function] [Function] [
    [b:Any a:Any] => [ ((a keyfn) (b keyfn) cmp) ]
  ]
]


# ====================================================================
# ALGORITHMS
# ====================================================================

# Swap two slots of a mutable FlexList in place. Returns nothing — call it
# as a bare statement (never `def`-bind a void call).
def swap-at fn [
  [j:Integer i:Integer arr:FlexList] [] [
    def vi (arr get i)
    def vj (arr get j)
    arr set i vj end drop
    arr set j vi end drop
  ]
]


# --- is-sorted ------------------------------------------------------

def is-sorted-fn fn [
  [comp:Function lst:List] [Boolean] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def ok (flex [true])
    def _ (iota n each [
      var [[i]
        if (i gt 0) [
          def c ((arr get (i sub 1)) (arr get i) comp)
          if (c gt 0) [ ok set 0 false end drop 0 ] [0]
        ] [0]
      ]
    ])
    ok get 0
  ]
]


# --- O(n^2) comparison sorts ----------------------------------------

# Bubble sort.
def bubble-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[_pass]
        def _i (iota (n sub 1) each [
          var [[i]
            def c ((arr get i) (arr get (i add 1)) comp)
            if (c gt 0) [ arr i (i add 1) swap-at end 0 ] [0]
          ]
        ])
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Insertion sort (stable).
def insertion-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[i]
        def key (arr get i)
        def jc (flex [i])
        def _sh (iota i each [
          var [[t]
            def j (jc get 0)
            if (j gt 0) [
              def prev (arr get (j sub 1))
              def c (prev key comp)
              if (c gt 0) [ arr set j prev end drop  jc set 0 (j sub 1) end drop  0 ] [0]
            ] [0]
          ]
        ])
        arr set (jc get 0) key end drop
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Selection sort.
def selection-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[i]
        def mi (flex [i])
        def _f (iota n each [
          var [[j]
            if (j gt i) [
              def c ((arr get j) (arr get (mi get 0)) comp)
              if (c lt 0) [ mi set 0 j end drop 0 ] [0]
            ] [0]
          ]
        ])
        arr i (mi get 0) swap-at end
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]


# --- divide & conquer (in-place on the working FlexList) ------------
#
# These helpers mutate the working FlexList in place and RETURN it, so a
# recursive call can be `def`-bound (a void call cannot). The comparator
# is threaded directly as the `comp:Function` parameter and forwarded to
# recursive calls as `comp/v` (a bare `comp` would CALL it — ADR-011).
#
# Works around a boru compiler defect (the open remainder of NUR123, boru
# main @ 64c5ab2): a fn body that reads its Function param BOTH bare (to
# invoke it) and by `/v` (to forward it) is either refused at compile time
# ("binding `comp` is read both bare and by /v in one body") or — when it
# is reached from inside an `each` body — compiled into a replay island
# that corrupts a LATER call's loop state (`Sort.heap` followed by
# `Sort.tim` returned the input unsorted, or raised `undefined word: ip`).
# So every helper that forwards `comp/v` also INVOKES it through `/v`:
# `xi xj comp/v apply`, which is the same call. Sorts that never forward
# the comparator keep the idiomatic bare `xi xj comp`. Go back to the bare
# spelling when the defect is fixed upstream.

# Quicksort — Lomuto partition on the last element.
def quick-go fn [
  [comp:Function hi:Integer lo:Integer arr:FlexList] [FlexList] [
    if (lo lt hi) [
      def pivot (arr get hi)
      def ic (flex [lo])
      def _ (iota (hi sub lo) each [
        var [[t]
          def j (lo add t)
          def c ((arr get j) pivot comp/v apply)  # NUR123 workaround (see header)
          if (c lt 0) [
            def i (ic get 0)
            arr i j swap-at end
            ic set 0 (i add 1) end drop
            0
          ] [0]
        ]
      ])
      def p (ic get 0)
      arr p hi swap-at end
      def _l (arr lo (p sub 1) comp/v quick-go)
      def _r (arr (p add 1) hi comp/v quick-go)
      arr
    ] [ arr ]
  ]
]

def quick-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (if (n gt 1) [ arr 0 (n sub 1) comp/v quick-go ] [ arr ])
    arr slice 0 (arr size)
  ]
]

# Merge sort (stable) — the cross-check reference implementation.
def merge-span fn [
  [comp:Function buf:FlexList hi:Integer mid:Integer lo:Integer arr:FlexList] [FlexList] [
    def i (flex [lo])
    def j (flex [mid])
    def k (flex [lo])
    def _ (iota (hi sub lo) each [
      var [[t]
        def ii (i get 0)
        def jj (j get 0)
        def take-left (
          if (ii gte mid) [false] [
            if (jj gte hi) [true] [
              def c ((arr get ii) (arr get jj) comp)
              (c lte 0)
            ]
          ]
        )
        if take-left [
          buf set (k get 0) (arr get ii) end drop
          i set 0 (ii add 1) end drop
          0
        ] [
          buf set (k get 0) (arr get jj) end drop
          j set 0 (jj add 1) end drop
          0
        ]
        k set 0 ((k get 0) add 1) end drop
        0
      ]
    ])
    def _c (iota (hi sub lo) each [
      var [[t]
        def idx (lo add t)
        arr set idx (buf get idx) end drop
        0
      ]
    ])
    arr
  ]
]

def merge-go fn [
  [comp:Function buf:FlexList hi:Integer lo:Integer arr:FlexList] [FlexList] [
    if ((hi sub lo) gt 1) [
      def mid (lo add ((hi sub lo) div 2))
      def _l (arr lo mid buf comp/v merge-go)
      def _r (arr mid hi buf comp/v merge-go)
      arr lo mid hi buf comp/v merge-span
    ] [ arr ]
  ]
]

def merge-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def buf (flex (lst slice 0 (lst size)))
    def _ (arr 0 n buf comp/v merge-go)
    arr slice 0 (arr size)
  ]
]

# Heapsort (binary max-heap).
def sift-down fn [
  [comp:Function n:Integer i:Integer arr:FlexList] [FlexList] [
    def largest (flex [i])
    def l ((i mul 2) add 1)
    def r ((i mul 2) add 2)
    def _l (if (l lt n) [
      def c ((arr get l) (arr get (largest get 0)) comp/v apply)  # NUR123 workaround (see header)
      if (c gt 0) [ largest set 0 l end drop 0 ] [0]
    ] [0])
    def _r (if (r lt n) [
      def c ((arr get r) (arr get (largest get 0)) comp/v apply)  # NUR123 workaround (see header)
      if (c gt 0) [ largest set 0 r end drop 0 ] [0]
    ] [0])
    def lg (largest get 0)
    def _s (if (lg neq i) [
      arr i lg swap-at end
      arr lg n comp/v sift-down
    ] [ arr ])
    arr
  ]
]

def heap-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _b (iota (n div 2) each [
      var [[t]
        def i (((n div 2) sub 1) sub t)
        arr i n comp/v sift-down
        0
      ]
    ])
    def _e (iota n each [
      var [[t]
        def hi ((n sub 1) sub t)
        if (hi gt 0) [
          arr 0 hi swap-at end
          arr 0 hi comp/v sift-down
          0
        ] [0]
      ]
    ])
    arr slice 0 (arr size)
  ]
]


# --- more O(n^2) / gap comparison sorts -----------------------------
#
# The data-dependent loops below are written as bounded `iota` loops with
# an explicit state cell (written before boru grew `while`). Each bound is a
# proven worst-case step count for that algorithm (≤ n² moves), so the
# loop always reaches the sorted state and then idles.

# Gnome sort.
def gnome-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def pos (flex [0])
    def steps ((n add 1) mul (n add 1))
    def _ (iota steps each [
      var [[t]
        def p (pos get 0)
        if (p lt n) [
          if (p eq 0) [ pos set 0 1 end drop 0 ] [
            def c ((arr get (p sub 1)) (arr get p) comp)
            if (c gt 0) [
              arr (p sub 1) p swap-at end
              pos set 0 (p sub 1) end drop
              0
            ] [ pos set 0 (p add 1) end drop 0 ]
          ]
        ] [0]
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Cocktail shaker sort (bidirectional bubble). n full sweeps suffice.
def cocktail-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[_pass]
        def _f (iota (n sub 1) each [
          var [[i]
            def c ((arr get i) (arr get (i add 1)) comp)
            if (c gt 0) [ arr i (i add 1) swap-at end 0 ] [0]
          ]
        ])
        def _b (iota (n sub 1) each [
          var [[t]
            def i ((n sub 2) sub t)
            def c ((arr get i) (arr get (i add 1)) comp)
            if (c gt 0) [ arr i (i add 1) swap-at end 0 ] [0]
          ]
        ])
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Comb sort: shrink the gap geometrically, then finish with bubble
# sweeps. n outer sweeps cover both the gap-shrink and the final passes.
def comb-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def gap (flex [n])
    def _ (iota n each [
      var [[_pass]
        def g0 (gap get 0)
        def g ((g0 mul 10) div 13)
        def gg (if (g lt 1) [1] [g])
        gap set 0 gg end drop
        def _s (iota n each [
          var [[i]
            if ((i add gg) lt n) [
              def c ((arr get i) (arr get (i add gg)) comp)
              if (c gt 0) [ arr i (i add gg) swap-at end 0 ] [0]
            ] [0]
          ]
        ])
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Shell sort with the halving (Shell's original) gap sequence.
def shell-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def gap (flex [(n div 2)])
    def _ (iota n each [
      var [[_gstep]
        def g (gap get 0)
        if (g gt 0) [
          def _ins (iota n each [
            var [[i]
              if (i gte g) [
                # jc is a one-cell mutable index cursor. Built empty then
                # set (not `flex [i]`): a `flex` list body that reads a
                # loop-frame-local re-materialises via dynamic scope, which
                # the byte compiler cannot bind through the enclosing each
                # closure (it faults `dynamic-scope read miss` and falls back
                # to the interpreter). `flex [0]` is inert, so it lowers.
                def jc (flex [0])
                def _jci (jc set 0 i end drop 0)
                def _sh (iota n each [
                  var [[s]
                    def j (jc get 0)
                    if (j gte g) [
                      def c ((arr get (j sub g)) (arr get j) comp)
                      if (c gt 0) [ arr j (j sub g) swap-at end  jc set 0 (j sub g) end drop  0 ] [0]
                    ] [0]
                  ]
                ])
                0
              ] [0]
            ]
          ])
          gap set 0 (g div 2) end drop
          0
        ] [0]
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Odd–even (brick) sort. n phase-pairs guarantee a sorted result.
def odd-even-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[_pass]
        def _o (iota n each [
          var [[i]
            if (((i mod 2) eq 1) and ((i add 1) lt n)) [
              def c ((arr get i) (arr get (i add 1)) comp)
              if (c gt 0) [ arr i (i add 1) swap-at end 0 ] [0]
            ] [0]
          ]
        ])
        def _e (iota n each [
          var [[i]
            if (((i mod 2) eq 0) and ((i add 1) lt n)) [
              def c ((arr get i) (arr get (i add 1)) comp)
              if (c gt 0) [ arr i (i add 1) swap-at end 0 ] [0]
            ] [0]
          ]
        ])
        0
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Cycle sort — minimal writes; each element placed by counting ranks.
def cycle-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[cs]
        if (cs lt (n sub 1)) [
          def item (flex [(arr get cs)])
          def posc (flex [cs])
          # initial rank of item among [cs+1 .. n-1]
          def _r0 (iota n each [
            var [[i]
              if (i gt cs) [
                def c ((arr get i) (item get 0) comp)
                if (c lt 0) [ posc set 0 ((posc get 0) add 1) end drop 0 ] [0]
              ] [0]
            ]
          ])
          if ((posc get 0) eq cs) [0] [
            # skip duplicates
            def _d0 (iota n each [
              var [[t]
                def p (posc get 0)
                if (p lt n) [
                  def c ((item get 0) (arr get p) comp)
                  if (c eq 0) [ posc set 0 (p add 1) end drop 0 ] [0]
                ] [0]
              ]
            ])
            def tmp (arr get (posc get 0))
            arr set (posc get 0) (item get 0) end drop
            item set 0 tmp end drop
            # rotate the rest of the cycle
            def _cyc (iota (n mul n) each [
              var [[t]
                if ((posc get 0) neq cs) [
                  posc set 0 cs end drop
                  def _r (iota n each [
                    var [[i]
                      if (i gt cs) [
                        def c ((arr get i) (item get 0) comp)
                        if (c lt 0) [ posc set 0 ((posc get 0) add 1) end drop 0 ] [0]
                      ] [0]
                    ]
                  ])
                  def _d (iota n each [
                    var [[_u]
                      def p (posc get 0)
                      if (p lt n) [
                        def c ((item get 0) (arr get p) comp)
                        if (c eq 0) [ posc set 0 (p add 1) end drop 0 ] [0]
                      ] [0]
                    ]
                  ])
                  def tmp2 (arr get (posc get 0))
                  arr set (posc get 0) (item get 0) end drop
                  item set 0 tmp2 end drop
                  0
                ] [0]
              ]
            ])
            0
          ]
        ] [0]
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Pancake sort — repeatedly flip the largest remaining element to the top
# then flip it down into place.
def flip-prefix fn [
  [k:Integer arr:FlexList] [] [
    def half ((k add 1) div 2)
    def _ (iota half each [
      var [[i]
        arr i (k sub i) swap-at end
        0
      ]
    ])
  ]
]

def pancake-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[t]
        def sz (n sub t)
        if (sz gt 1) [
          def mi (flex [0])
          def _f (iota sz each [
            var [[i]
              def c ((arr get i) (arr get (mi get 0)) comp)
              if (c gt 0) [ mi set 0 i end drop 0 ] [0]
            ]
          ])
          def m (mi get 0)
          def _flip (if (m neq (sz sub 1)) [
            arr m flip-prefix end
            arr (sz sub 1) flip-prefix end
            0
          ] [0])
          0
        ] [0]
      ]
    ])
    arr slice 0 (arr size)
  ]
]

# Bitonic sort, generalised to any length via the greatest-power-of-two
# split. Recurses on index ranges (a named word, so the recursion
# resolves — unlike a recursive comparator). `dir` true = ascending.
def gp2lt fn [
  [m:Integer] [Integer] [
    def k (flex [1])
    def _ (iota m each [
      var [[t]
        if (((k get 0) mul 2) lt m) [ k set 0 ((k get 0) mul 2) end drop 0 ] [0]
      ]
    ])
    k get 0
  ]
]

def bitonic-merge fn [
  [comp:Function dir:Boolean cnt:Integer lo:Integer arr:FlexList] [FlexList] [
    if (cnt gt 1) [
      def k (cnt gp2lt)
      def _ (iota (cnt sub k) each [
        var [[t]
          def i (lo add t)
          def c ((arr get i) (arr get (i add k)) comp/v apply)  # NUR123 workaround (see header)
          def wrong (if dir [c gt 0] [c lt 0])
          if wrong [ arr i (i add k) swap-at end 0 ] [0]
        ]
      ])
      def _l (arr lo k dir comp/v bitonic-merge)
      def _r (arr (lo add k) (cnt sub k) dir comp/v bitonic-merge)
      arr
    ] [ arr ]
  ]
]

def bitonic-go fn [
  [comp:Function dir:Boolean cnt:Integer lo:Integer arr:FlexList] [FlexList] [
    if (cnt gt 1) [
      def m (cnt div 2)
      def _l (arr lo m (dir not) comp/v bitonic-go)
      def _r (arr (lo add m) (cnt sub m) dir comp/v bitonic-go)
      arr lo cnt dir comp/v bitonic-merge
    ] [ arr ]
  ]
]

def bitonic-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (if (n gt 1) [ arr 0 n true comp/v bitonic-go ] [ arr ])
    arr slice 0 (arr size)
  ]
]


# --- helpers for distribution sorts ---------------------------------

def list-min fn [
  [lst:List] [Integer] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def m (flex [(arr get 0)])
    def _ (iota n each [
      var [[i] def v (arr get i) if (v lt (m get 0)) [ m set 0 v end drop 0 ] [0] ]
    ])
    m get 0
  ]
]

def list-max fn [
  [lst:List] [Integer] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def m (flex [(arr get 0)])
    def _ (iota n each [
      var [[i] def v (arr get i) if (v gt (m get 0)) [ m set 0 v end drop 0 ] [0] ]
    ])
    m get 0
  ]
]

# Validate that every element is an Integer (distribution sorts need it).
def ensure-ints fn [
  [name:String lst:List] [] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[i]
        if (((arr get i) is Integer) not) [
          def msg `Sort.${name}: needs Integer elements (got ${(arr get i)})`
          raise bad_input msg
        ] [0]
      ]
    ])
  ]
]

# Validate non-negative Integers (radix / bead).
def ensure-non-neg fn [
  [name:String lst:List] [] [
    lst name ensure-ints
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (iota n each [
      var [[i]
        if ((arr get i) lt 0) [
          def msg `Sort.${name}: needs non-negative Integers (got ${(arr get i)})`
          raise bad_input msg
        ] [0]
      ]
    ])
  ]
]


# --- distribution sorts (Integers, ascending; no comparator) --------

# Counting sort. Handles negatives via a min offset.
def counting-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n eq 0) [ [] ] [
      lst "counting" ensure-ints
      def mn (lst list-min)
      def mx (lst list-max)
      def span ((mx sub mn) add 1)
      def _g (if (span gt 100000000) [
        def msg `Sort.counting: value span too large (${span})`
        raise bad_input msg
      ] [0])
      def counts (flex (iota span each [drop 0]))
      def arr (flex (lst slice 0 (lst size)))
      def _c (iota n each [
        var [[i]
          def idx ((arr get i) sub mn)
          counts set idx ((counts get idx) add 1) end drop
          0
        ]
      ])
      def out (flex (iota n each [drop 0]))
      def oc (flex [0])
      def _b (iota span each [
        var [[v]
          def _r (iota (counts get v) each [
            var [[r]
              out set (oc get 0) (v add mn) end drop
              oc set 0 ((oc get 0) add 1) end drop
              0
            ]
          ])
          0
        ]
      ])
      out slice 0 (out size)
    ]
  ]
]

# Pigeonhole sort — like counting, framed as holes that hold the items.
def pigeonhole-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n eq 0) [ [] ] [
      lst "pigeonhole" ensure-ints
      def mn (lst list-min)
      def mx (lst list-max)
      def holes ((mx sub mn) add 1)
      def _g (if (holes gt 100000000) [
        def msg `Sort.pigeonhole: value span too large (${holes})`
        raise bad_input msg
      ] [0])
      def counts (flex (iota holes each [drop 0]))
      def arr (flex (lst slice 0 (lst size)))
      def _c (iota n each [
        var [[i]
          def h ((arr get i) sub mn)
          counts set h ((counts get h) add 1) end drop
          0
        ]
      ])
      def out (flex (iota n each [drop 0]))
      def oc (flex [0])
      def _b (iota holes each [
        var [[h]
          def _r (iota (counts get h) each [
            var [[r]
              out set (oc get 0) (h add mn) end drop
              oc set 0 ((oc get 0) add 1) end drop
              0
            ]
          ])
          0
        ]
      ])
      out slice 0 (out size)
    ]
  ]
]

# Radix sort, least-significant-digit, base 10, stable. Non-negative.
def radix-lsd-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      lst "radix-lsd" ensure-non-neg
      def mx (lst list-max)
      def cur (flex (lst slice 0 (lst size)))
      def place (flex [1])
      def _ (iota 19 each [
        var [[_d]
          def pl (place get 0)
          if (pl lte mx) [
            def counts (flex (iota 10 each [drop 0]))
            def _c1 (iota n each [
              var [[i]
                def dig (((cur get i) div pl) mod 10)
                counts set dig ((counts get dig) add 1) end drop
                0
              ]
            ])
            def acc (flex [0])
            def _ps (iota 10 each [
              var [[v]
                def cv (counts get v)
                counts set v (acc get 0) end drop
                acc set 0 ((acc get 0) add cv) end drop
                0
              ]
            ])
            def out (flex (iota n each [drop 0]))
            def _c2 (iota n each [
              var [[i]
                def dig (((cur get i) div pl) mod 10)
                def pos (counts get dig)
                out set pos (cur get i) end drop
                counts set dig (pos add 1) end drop
                0
              ]
            ])
            def _cp (iota n each [ var [[i] cur set i (out get i) end drop 0 ] ])
            place set 0 (pl mul 10) end drop
            0
          ] [0]
        ]
      ])
      cur slice 0 (cur size)
    ]
  ]
]

# Radix sort, most-significant-digit, base 10, recursive. Non-negative.
def msd-go fn [
  [place:Integer hi:Integer lo:Integer arr:FlexList] [FlexList] [
    def cnt ((hi sub lo) add 1)
    if ((cnt lte 1) or (place lt 1)) [ arr ] [
      def counts (flex (iota 11 each [drop 0]))
      def _c1 (iota cnt each [
        var [[t]
          def dig (((arr get (lo add t)) div place) mod 10)
          counts set (dig add 1) ((counts get (dig add 1)) add 1) end drop
          0
        ]
      ])
      def _ps (iota 10 each [
        var [[v]
          counts set (v add 1) ((counts get (v add 1)) add (counts get v)) end drop
          0
        ]
      ])
      # separate cursor FlexList so the scatter does not clobber `counts`
      # (the bucket boundaries are read back from `counts` to recurse).
      def cur (flex (iota 11 each [ var [[v] counts get v ] ]))
      def tmp (flex (iota cnt each [drop 0]))
      def _c2 (iota cnt each [
        var [[t]
          def dig (((arr get (lo add t)) div place) mod 10)
          def pos (cur get dig)
          tmp set pos (arr get (lo add t)) end drop
          cur set dig (pos add 1) end drop
          0
        ]
      ])
      def _cp (iota cnt each [ var [[t] arr set (lo add t) (tmp get t) end drop 0 ] ])
      # recurse into each digit bucket [counts[v], counts[v+1])
      def _rec (iota 10 each [
        var [[v]
          def b-lo (lo add (counts get v))
          def b-hi (lo add ((counts get (v add 1)) sub 1))
          def np (place div 10)
          def _r (if (b-hi gt b-lo) [ arr b-lo b-hi np msd-go ] [ arr ])
          0
        ]
      ])
      arr
    ]
  ]
]

def radix-msd-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      lst "radix-msd" ensure-non-neg
      def mx (lst list-max)
      def place (flex [1])
      def _ (iota 19 each [
        var [[_d] if (((place get 0) mul 10) lte mx) [ place set 0 ((place get 0) mul 10) end drop 0 ] [0] ]
      ])
      def arr (flex (lst slice 0 (lst size)))
      def _s (arr 0 (n sub 1) (place get 0) msd-go)
      arr slice 0 (arr size)
    ]
  ]
]

# Bucket sort over Integers: scatter into value-span buckets, sort each
# bucket by insertion, gather. (Distribution sort: ascending.)
def bucket-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      lst "bucket" ensure-ints
      def mn (lst list-min)
      def mx (lst list-max)
      if (mn eq mx) [ lst ] [
        def span ((mx sub mn) add 1)
        # n buckets; bucket index = (x-mn)*n / span, clamped to n-1
        def bcount (flex (iota n each [drop 0]))
        def arr (flex (lst slice 0 (lst size)))
        def _bc (iota n each [
          var [[i]
            def raw ((((arr get i) sub mn) mul n) div span)
            def bi (if (raw gte n) [(n sub 1)] [raw])
            bcount set bi ((bcount get bi) add 1) end drop
            0
          ]
        ])
        # bucket start offsets (prefix sums)
        def starts (flex (iota n each [drop 0]))
        def acc (flex [0])
        def _ps (iota n each [
          var [[b]
            starts set b (acc get 0) end drop
            acc set 0 ((acc get 0) add (bcount get b)) end drop
            0
          ]
        ])
        # scatter (stable) into out by bucket
        def out (flex (iota n each [drop 0]))
        def fill (flex (iota n each [drop 0]))
        def _sc (iota n each [
          var [[i]
            def raw ((((arr get i) sub mn) mul n) div span)
            def bi (if (raw gte n) [(n sub 1)] [raw])
            def pos ((starts get bi) add (fill get bi))
            out set pos (arr get i) end drop
            fill set bi ((fill get bi) add 1) end drop
            0
          ]
        ])
        # insertion-sort each bucket in place within out
        def _is (iota n each [
          var [[b]
            def s (starts get b)
            def cnt (bcount get b)
            def _ins (iota cnt each [
              var [[t]
                def i (s add t)
                def key (out get i)
                # jc is a one-cell mutable index cursor. Built empty then
                # set (not `flex [i]`): a `flex` list body that reads a
                # loop-frame-local re-materialises via dynamic scope, which
                # the byte compiler cannot bind through the enclosing each
                # closure (it faults `dynamic-scope read miss` and falls back
                # to the interpreter). `flex [0]` is inert, so it lowers.
                def jc (flex [0])
                def _jci (jc set 0 i end drop 0)
                def _sh (iota cnt each [
                  var [[_u]
                    def j (jc get 0)
                    if (j gt s) [
                      def prev (out get (j sub 1))
                      if (prev gt key) [ out set j prev end drop  jc set 0 (j sub 1) end drop  0 ] [0]
                    ] [0]
                  ]
                ])
                out set (jc get 0) key end drop
                0
              ]
            ])
            0
          ]
        ])
        out slice 0 (out size)
      ]
    ]
  ]
]

# Bead (gravity) sort. Non-negative Integers; values fall like beads.
def bead-sort fn [
  [lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      lst "bead" ensure-non-neg
      def mx (lst list-max)
      def arr (flex (lst slice 0 (lst size)))
      # cnt[j] = number of elements strictly greater than column index j
      def cnt (flex (iota mx each [drop 0]))
      def _c (iota mx each [
        var [[j]
          def c (flex [0])
          def _i (iota n each [
            var [[i] if ((arr get i) gt j) [ c set 0 ((c get 0) add 1) end drop 0 ] [0] ]
          ])
          cnt set j (c get 0) end drop
          0
        ]
      ])
      # row r (descending order) value = number of columns with cnt[j] > r
      def out (flex (iota n each [drop 0]))
      def _o (iota n each [
        var [[r]
          def v (flex [0])
          def _j (iota mx each [
            var [[j] if ((cnt get j) gt r) [ v set 0 ((v get 0) add 1) end drop 0 ] [0] ]
          ])
          out set r (v get 0) end drop
          0
        ]
      ])
      # reverse (descending → ascending)
      def res (flex (iota n each [drop 0]))
      def _rv (iota n each [ var [[i] res set i (out get ((n sub 1) sub i)) end drop 0 ] ])
      res slice 0 (res size)
    ]
  ]
]


# --- joke / educational sorts ---------------------------------------

# Bogosort — shuffle until sorted, with a hard safety cap. Uses a tiny
# deterministic LCG (boru has no ambient randomness), so it terminates for
# small inputs and raises `bogo_giveup` past the cap.
def bogo-cap 300000

def bogo-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      def arr (flex (lst slice 0 (lst size)))
      def seed (flex [2463534242])
      def done (flex [false])
      def _ (iota bogo-cap each [
        var [[t]
          if (done get 0) [0] [
            def sorted (flex [true])
            def _ck (iota (n sub 1) each [
              var [[i]
                def c ((arr get i) (arr get (i add 1)) comp)
                if (c gt 0) [ sorted set 0 false end drop 0 ] [0]
              ]
            ])
            if (sorted get 0) [ done set 0 true end drop 0 ] [
              def _sh (iota (n sub 1) each [
                var [[k]
                  def i ((n sub 1) sub k)
                  def s (((seed get 0) mul 1103515245) add 12345)
                  def s2 (s mod 2147483648)
                  seed set 0 s2 end drop
                  def j (s2 mod (i add 1))
                  arr i j swap-at end
                  0
                ]
              ])
              0
            ]
          ]
        ]
      ])
      if (done get 0) [ arr slice 0 (arr size) ] [
        def msg `Sort.bogo: gave up after ${bogo-cap} shuffles (n=${n}); use it only on tiny inputs`
        raise bogo_giveup msg
      ]
    ]
  ]
]

# Stooge sort — O(n^2.7), recursive.
def stooge-go fn [
  [comp:Function hi:Integer lo:Integer arr:FlexList] [FlexList] [
    def c ((arr get lo) (arr get hi) comp/v apply)  # NUR123 workaround (see header)
    def _sw (if (c gt 0) [ arr lo hi swap-at end 0 ] [0])
    def len ((hi sub lo) add 1)
    def _r (if (len gt 2) [
      def t (len div 3)
      def _1 (arr lo (hi sub t) comp/v stooge-go)
      def _2 (arr (lo add t) hi comp/v stooge-go)
      def _3 (arr lo (hi sub t) comp/v stooge-go)
      arr
    ] [ arr ])
    arr
  ]
]

def stooge-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (if (n gt 1) [ arr 0 (n sub 1) comp/v stooge-go ] [ arr ])
    arr slice 0 (arr size)
  ]
]

# Slowsort — "multiply and surrender", recursive, gloriously inefficient.
def slow-go fn [
  [comp:Function hi:Integer lo:Integer arr:FlexList] [FlexList] [
    if (lo gte hi) [ arr ] [
      def m ((lo add hi) div 2)
      def _1 (arr lo m comp/v slow-go)
      def _2 (arr (m add 1) hi comp/v slow-go)
      def c ((arr get hi) (arr get m) comp/v apply)  # NUR123 workaround (see header)
      def _sw (if (c lt 0) [ arr hi m swap-at end 0 ] [0])
      def _3 (arr lo (hi sub 1) comp/v slow-go)
      arr
    ]
  ]
]

def slow-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (if (n gt 1) [ arr 0 (n sub 1) comp/v slow-go ] [ arr ])
    arr slice 0 (arr size)
  ]
]


# --- introsort & timsort --------------------------------------------

def floor-log2 fn [
  [n:Integer] [Integer] [
    def k (flex [0])
    def v (flex [1])
    def _ (iota n each [
      var [[t] if (((v get 0) mul 2) lte n) [ v set 0 ((v get 0) mul 2) end drop  k set 0 ((k get 0) add 1) end drop  0 ] [0] ]
    ])
    k get 0
  ]
]

# Heapsort over a sub-span arr[lo..hi] — introsort's guaranteed fallback.
def sift-down-span fn [
  [comp:Function hi:Integer i:Integer lo:Integer arr:FlexList] [FlexList] [
    def largest (flex [i])
    def li (((((i sub lo) mul 2) add 1) add lo))
    def ri (((((i sub lo) mul 2) add 2) add lo))
    def _l (if (li lte hi) [
      def c ((arr get li) (arr get (largest get 0)) comp/v apply)  # NUR123 workaround (see header)
      if (c gt 0) [ largest set 0 li end drop 0 ] [0]
    ] [0])
    def _r (if (ri lte hi) [
      def c ((arr get ri) (arr get (largest get 0)) comp/v apply)  # NUR123 workaround (see header)
      if (c gt 0) [ largest set 0 ri end drop 0 ] [0]
    ] [0])
    def lg (largest get 0)
    def _s (if (lg neq i) [
      arr i lg swap-at end
      arr lo lg hi comp/v sift-down-span
    ] [ arr ])
    arr
  ]
]

def heap-span fn [
  [comp:Function hi:Integer lo:Integer arr:FlexList] [FlexList] [
    def cnt ((hi sub lo) add 1)
    def _b (iota (cnt div 2) each [
      var [[t]
        def i ((lo add ((cnt div 2) sub 1)) sub t)
        arr lo i hi comp/v sift-down-span
        0
      ]
    ])
    def _e (iota cnt each [
      var [[t]
        def e (hi sub t)
        if (e gt lo) [
          arr lo e swap-at end
          arr lo lo (e sub 1) comp/v sift-down-span
          0
        ] [0]
      ]
    ])
    arr
  ]
]

def intro-go fn [
  [comp:Function lim:Integer hi:Integer lo:Integer arr:FlexList] [FlexList] [
    if (lo lt hi) [
      if (lim eq 0) [ arr lo hi comp/v heap-span ] [
        def pivot (arr get hi)
        def ic (flex [lo])
        def _ (iota (hi sub lo) each [
          var [[t]
            def j (lo add t)
            def c ((arr get j) pivot comp/v apply)  # NUR123 workaround (see header)
            if (c lt 0) [
              def i (ic get 0)
              arr i j swap-at end
              ic set 0 (i add 1) end drop
              0
            ] [0]
          ]
        ])
        def p (ic get 0)
        arr p hi swap-at end
        def _l (arr lo (p sub 1) (lim sub 1) comp/v intro-go)
        def _r (arr (p add 1) hi (lim sub 1) comp/v intro-go)
        arr
      ]
    ] [ arr ]
  ]
]

def intro-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    def arr (flex (lst slice 0 (lst size)))
    def _ (if (n gt 1) [
      def lim ((n floor-log2) mul 2)
      arr 0 (n sub 1) lim comp/v intro-go
    ] [ arr ])
    arr slice 0 (arr size)
  ]
]

# Timsort (core): sort by detecting natural ascending runs and merging
# them left to right with the stable merge used by `Sort.merge`.
def tim-sort fn [
  [comp:Function lst:List] [List] [
    def n (lst size)
    if (n lte 1) [ lst ] [
      def arr (flex (lst slice 0 (lst size)))
      def buf (flex (lst slice 0 (lst size)))
      def bounds (flex (iota (n add 1) each [drop 0]))
      def nb (flex [0])
      def ip (flex [0])
      def _ (iota (n add 1) each [
        var [[t]
          if ((ip get 0) lt n) [
            def st (ip get 0)
            def j (flex [(st add 1)])
            def stopped (flex [false])
            def _run (iota n each [
              var [[_u]
                if (stopped get 0) [0] [
                  def jj (j get 0)
                  if (jj lt n) [
                    def c ((arr get (jj sub 1)) (arr get jj) comp/v apply)  # NUR123 workaround (see header)
                    if (c lte 0) [ j set 0 (jj add 1) end drop 0 ] [ stopped set 0 true end drop 0 ]
                  ] [ stopped set 0 true end drop 0 ]
                ]
              ]
            ])
            def re (j get 0)
            bounds set (nb get 0) re end drop
            nb set 0 ((nb get 0) add 1) end drop
            ip set 0 re end drop
            0
          ] [0]
        ]
      ])
      def merged-end (flex [(bounds get 0)])
      def _m (iota (nb get 0) each [
        var [[r]
          if (r gt 0) [
            def me (merged-end get 0)
            def re (bounds get r)
            def _x (arr 0 me re buf comp/v merge-span)
            merged-end set 0 re end drop
            0
          ] [0]
        ]
      ])
      arr slice 0 (arr size)
    ]
  ]
]


# --- default ordering -----------------------------------------------

# The recommended general-purpose sort (stable).
def default-sort fn [
  [comp:Function lst:List] [List] [
    lst comp/v merge-sort
  ]
]


# ====================================================================
# NAMESPACE
# ====================================================================

export "Sort" {
  # comparators
  by-number:        by-number/v
  by-string:        by-string/v
  by-boolean:       by-boolean/v
  by-generic:       by-generic/v
  natural:          natural/v
  case-insensitive: case-insensitive/v
  reverse:          rev-cmp/v
  by-key:           by-key-cmp/v

  # predicate
  is-sorted: is-sorted-fn/v

  # comparison sorts
  bubble:    bubble-sort/v
  insertion: insertion-sort/v
  selection: selection-sort/v
  gnome:     gnome-sort/v
  cocktail:  cocktail-sort/v
  comb:      comb-sort/v
  shell:     shell-sort/v
  odd-even:  odd-even-sort/v
  cycle:     cycle-sort/v
  pancake:   pancake-sort/v
  bitonic:   bitonic-sort/v
  quick:     quick-sort/v
  merge:     merge-sort/v
  heap:      heap-sort/v
  intro:     intro-sort/v
  tim:       tim-sort/v

  # joke / educational sorts (comparator-driven)
  bogo:      bogo-sort/v
  stooge:    stooge-sort/v
  slow:      slow-sort/v

  # distribution sorts (Integers, ascending; no comparator)
  counting:    counting-sort/v
  pigeonhole:  pigeonhole-sort/v
  radix-lsd:   radix-lsd-sort/v
  radix-msd:   radix-msd-sort/v
  bucket:      bucket-sort/v
  bead:        bead-sort/v

  sort:      default-sort/v
}
