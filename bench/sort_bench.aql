# Performance baseline workload for the Sort library.
#
# Times each representative algorithm sorting a fixed, deterministic
# pseudo-random Integer array and prints one `<algo> <ms>` line per run
# (execution-only wall-clock via boru:time-util, so process start, parse,
# the pre-flight check and compilation are excluded). boru has ONE execution
# path — the program is compiled to bytecode and run on the VM — so there
# is one column of numbers; see bench/run.sh, which runs each algorithm in
# its own process and tabulates the best of several runs.
#
#   boru bench/sort_bench.aql           # ad-hoc, one run of everything
#   bench/run.sh                        # best-of-N per algorithm, tabulated
#
# Sizes are split so the O(n^2) family stays bounded while the
# O(n log n) / distribution family gets a big enough n for the number to
# mean something. The joke sorts (bogo /
# stooge / slow) are deliberately excluded — they are not throughput-
# meaningful.

# A relative import resolves against THIS file's directory (bench/).
import "../sort.aql"
import "boru:time-util"

# Deterministic pseudo-random fill: Knuth-multiplicative hash of the index,
# folded into [0, span). No RNG needed, so every run sorts the same data.
# Forward call: `mkarr span n` (signature order — span first).
def mkarr fn [
  [span:Integer n:Integer] [List] [
    iota n each [ var [[i] ((i mul 2654435761) mod span) ] ]
  ]
]

# Value bindings are lowercase: a Capitalised name binds a TYPE in boru
# (`def SMALL 200` would make SMALL a singleton literal type, not 200).
def n-small 200         # O(n^2) / sub-quadratic family
def n-large 800         # O(n log n) / distribution family
# Sizes are small on purpose: boru threads a first-class comparator through
# every element move, and that per-comparison fn dispatch — not the
# algorithm — dominates the wall-clock. They are big enough to rank the
# algorithms, which is the point of a baseline.

def s (mkarr 1000000 n-small)   # near-distinct values for the comparison sorts
def b (mkarr 1000000 n-large)   # near-distinct values for the comparison sorts
def bd (mkarr 4000 n-large)      # bounded range for the distribution sorts:
                              # counting / bucket are O(n + range), so a
                              # million-wide range would measure the range
                              # (and blow the runtime step budget), not the sort

print (`# n_small=${n-small} n_large=${n-large}`)

# --- O(n^2) / sub-quadratic (small n) ---
def t0 (TimeUtil.now) def _r0 (s Sort.insertion Sort.by-number/v end) print (`insertion ${(TimeUtil.total-ms (TimeUtil.elapsed t0))}`) end
def t1 (TimeUtil.now) def _r1 (s Sort.selection Sort.by-number/v end) print (`selection ${(TimeUtil.total-ms (TimeUtil.elapsed t1))}`) end
def t2 (TimeUtil.now) def _r2 (s Sort.bubble    Sort.by-number/v end) print (`bubble ${(TimeUtil.total-ms (TimeUtil.elapsed t2))}`) end
def t3 (TimeUtil.now) def _r3 (s Sort.shell     Sort.by-number/v end) print (`shell ${(TimeUtil.total-ms (TimeUtil.elapsed t3))}`) end
def t4 (TimeUtil.now) def _r4 (s Sort.comb      Sort.by-number/v end) print (`comb ${(TimeUtil.total-ms (TimeUtil.elapsed t4))}`) end

# --- O(n log n) comparison (large n) ---
def t5 (TimeUtil.now) def _r5 (b Sort.quick Sort.by-number/v end) print (`quick ${(TimeUtil.total-ms (TimeUtil.elapsed t5))}`) end
def t6 (TimeUtil.now) def _r6 (b Sort.merge Sort.by-number/v end) print (`merge ${(TimeUtil.total-ms (TimeUtil.elapsed t6))}`) end
def t7 (TimeUtil.now) def _r7 (b Sort.heap  Sort.by-number/v end) print (`heap ${(TimeUtil.total-ms (TimeUtil.elapsed t7))}`) end
def t8 (TimeUtil.now) def _r8 (b Sort.intro Sort.by-number/v end) print (`intro ${(TimeUtil.total-ms (TimeUtil.elapsed t8))}`) end
def t9 (TimeUtil.now) def _r9 (b Sort.tim   Sort.by-number/v end) print (`tim ${(TimeUtil.total-ms (TimeUtil.elapsed t9))}`) end
def ta (TimeUtil.now) def _ra (b Sort.sort  Sort.by-number/v end) print (`default ${(TimeUtil.total-ms (TimeUtil.elapsed ta))}`) end

# --- distribution (large n, no comparator, bounded range) ---
def tb (TimeUtil.now) def _rb (bd Sort.counting  end) print (`counting ${(TimeUtil.total-ms (TimeUtil.elapsed tb))}`) end
def tc (TimeUtil.now) def _rc (bd Sort.radix-lsd end) print (`radix-lsd ${(TimeUtil.total-ms (TimeUtil.elapsed tc))}`) end
def td (TimeUtil.now) def _rd (bd Sort.bucket    end) print (`bucket ${(TimeUtil.total-ms (TimeUtil.elapsed td))}`) end

print ("done")
